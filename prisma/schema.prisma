// Business Hub — Prisma schema (Section 6)
// Postgres via Supabase. Stock quantity is NEVER a stored column — it is
// always derived from StockMovement (see Section 5.1 and lib/stock.ts).

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  staff
}

enum UserStatus {
  active
  disabled
}

enum StockMovementType {
  restock
  adjustment
  damage
  return
  sale
}

enum PaymentStatus {
  paid
  partial
  credit
}

enum PaymentMethod {
  cash
  transfer
  pos_card
  credit
}

model Shop {
  id                  String   @id @default(uuid())
  name                String
  ownerContact        String   @map("owner_contact")
  currency            String   @default("NGN")
  logoUrl             String?  @map("logo_url")
  subscriptionStatus  String   @default("free") @map("subscription_status")
  createdAt           DateTime @default(now()) @map("created_at")

  branches   Branch[]
  users      User[]
  categories Category[]
  units      Unit[]
  products   Product[]
  customers  Customer[]
  sales      Sale[]
  expenses   Expense[]
  activityLogs ActivityLog[]

  @@map("shops")
}

model Branch {
  id      String  @id @default(uuid())
  shopId  String  @map("shop_id")
  name    String
  address String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]
  sales    Sale[]
  expenses Expense[]

  @@index([shopId])
  @@map("branches")
}

model User {
  id                     String     @id @default(uuid())
  shopId                 String     @map("shop_id")
  name                   String
  contact                String
  passwordHash           String     @map("password_hash")
  role                   Role       @default(staff)
  canSeeCostAndProfit    Boolean    @default(false) @map("can_see_cost_and_profit")
  inviteCode             String?    @unique @map("invite_code")
  inviteExpiresAt        DateTime?  @map("invite_expires_at")
  resetToken             String?    @unique @map("reset_token")
  resetTokenExpiresAt    DateTime?  @map("reset_token_expires_at")
  status                 UserStatus @default(active)
  createdAt              DateTime   @default(now()) @map("created_at")

  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productsCreated Product[]      @relation("ProductCreatedBy")
  stockMovements  StockMovement[]
  sales           Sale[]
  payments        Payment[]
  saleReturns     SaleReturn[]
  expenses        Expense[]
  activityLogs    ActivityLog[]

  @@index([shopId])
  @@map("users")
}

model Category {
  id     String @id @default(uuid())
  shopId String @map("shop_id")
  name   String

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([shopId])
  @@map("categories")
}

model Unit {
  id     String @id @default(uuid())
  shopId String @map("shop_id")
  name   String

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([shopId])
  @@map("units")
}

model Product {
  id                 String   @id @default(uuid())
  shopId             String   @map("shop_id")
  branchId           String   @map("branch_id")
  name               String
  categoryId         String?  @map("category_id")
  unitId             String   @map("unit_id")
  costPrice          Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellingPrice       Decimal  @map("selling_price") @db.Decimal(12, 2)
  lowStockThreshold  Int      @default(0) @map("low_stock_threshold")
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // current_quantity is NEVER stored — see lib/stock.ts getCurrentQuantity()

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  creator        User            @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([shopId])
  @@index([branchId])
  @@map("products")
}

model StockMovement {
  id              String            @id @default(uuid())
  productId       String            @map("product_id")
  type            StockMovementType
  quantityChange  Int               @map("quantity_change")
  note            String?
  performedBy     String            @map("performed_by")
  createdAt       DateTime          @default(now()) @map("created_at")

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  performer User   @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@map("stock_movements")
}

model Customer {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([shopId])
  @@map("customers")
}

model Sale {
  id             String        @id @default(uuid())
  shopId         String        @map("shop_id")
  branchId       String        @map("branch_id")
  customerId     String?       @map("customer_id")
  soldBy         String        @map("sold_by")
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @map("payment_status")
  paymentMethod  PaymentMethod @map("payment_method")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  seller       User         @relation(fields: [soldBy], references: [id])
  items        SaleItem[]
  payments     Payment[]
  returns      SaleReturn[]

  @@index([shopId])
  @@index([branchId])
  @@map("sales")
}

model SaleItem {
  id                 String  @id @default(uuid())
  saleId             String  @map("sale_id")
  productId          String  @map("product_id")
  quantity           Int
  unitPriceAtSale    Decimal @map("unit_price_at_sale") @db.Decimal(12, 2)
  costPriceAtSale    Decimal @map("cost_price_at_sale") @db.Decimal(12, 2)

  sale             Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  returnedAgainst  SaleReturnItem[]

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String        @map("sale_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  recordedBy    String        @map("recorded_by")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")

  sale     Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recorder User @relation(fields: [recordedBy], references: [id])

  @@index([saleId])
  @@map("payments")
}

model SaleReturn {
  id              String   @id @default(uuid())
  originalSaleId  String   @map("original_sale_id")
  returnedBy      String   @map("returned_by")
  reason          String?
  totalRefunded   Decimal  @map("total_refunded") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  originalSale Sale             @relation(fields: [originalSaleId], references: [id])
  returner     User             @relation(fields: [returnedBy], references: [id])
  items        SaleReturnItem[]

  @@index([originalSaleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id                String @id @default(uuid())
  saleReturnId      String @map("sale_return_id")
  saleItemId        String @map("sale_item_id")
  quantityReturned  Int    @map("quantity_returned")

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([saleReturnId])
  @@map("sale_return_items")
}

model Expense {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  branchId    String   @map("branch_id")
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  recordedBy  String   @map("recorded_by")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  shop     Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recorder User   @relation(fields: [recordedBy], references: [id])

  @@index([shopId])
  @@map("expenses")
}

model ActivityLog {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  userId      String   @map("user_id")
  actionType  String   @map("action_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([shopId])
  @@map("activity_logs")
}
